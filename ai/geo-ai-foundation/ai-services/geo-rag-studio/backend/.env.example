# Run uvicorn from geo-rag-studio/backend so these relative paths resolve in geo-rag-studio/data.
RAG_DB_PATH=../data/rag-v2.sqlite3
RAG_UPLOAD_DIR=../data/documents-v2
RAG_SEARCH_BACKEND=milvus

# Leave blank for BM25-only. Use an OpenAI-compatible embeddings endpoint.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=32

# Optional project-owned Milvus Standalone, matching Yuxi's v2.5.6 BM25/vector engine.
# Start backend/docker-compose.milvus.yml, then set this to the isolated Geo endpoint.
MILVUS_URI=http://127.0.0.1:19531
MILVUS_TOKEN=
MILVUS_DATABASE=geo_rag
MILVUS_COLLECTION_PREFIX=geo_rag

# Optional reranker endpoint (OpenAI-like or DashScope protocol).
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_PROTOCOL=openai

# Optional MinerU /file_parse adapter. No OCR service is bundled.
MINERU_ENABLED=false
MINERU_API_URI=
MINERU_API_KEY=
MINERU_TIMEOUT_SECONDS=1800

DEFAULT_FINAL_TOP_K=8
DEFAULT_RECALL_TOP_K=50
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3
CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175
