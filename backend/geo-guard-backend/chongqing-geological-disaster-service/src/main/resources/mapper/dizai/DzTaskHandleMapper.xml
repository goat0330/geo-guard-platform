<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.pku.whai.geological.disaster.service.mapper.DzTaskHandleMapper">

    <select id="getAllHandling"
            resultType="cn.edu.pku.whai.geological.disaster.service.domain.vo.DzTaskHandleVo">
        select dth.id, dth.center, dth.event_level
        from dz_task_handle dth
        where dth.handle_process in (1, 2, 3, 4)
    </select>
</mapper>
